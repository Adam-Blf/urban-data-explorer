POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ude
POSTGRES_USER=ude
POSTGRES_PASSWORD=ude
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ude
UDE_JWT_SECRET=change-me-in-production
UDE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Kafka bootstrap (partagé producteur + consommateur) ───────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
UDE_KAFKA_TOPIC=ude-events

# ── Streaming Vélib (aucune clé requise – GBFS public) ────────────────────
VELIB_GBFS_URL=https://velib-metropole-opendata.smovengo.cloud/opendata/Velib_Metropole/station_status.json
VELIB_POLL_INTERVAL_S=30
VELIB_KAFKA_TOPIC=ude-velib

# ── RATP temps réel (clé API PRIM requise – https://prim.iledefrance-mobilites.fr) ─
# Laisser vide pour désactiver ; le producteur est en mode stub si absent.
RATP_API_KEY=

# ── Météo Paris (clé OpenWeather requise – https://openweathermap.org/api) ──
# Laisser vide pour désactiver ; le producteur est en mode stub si absent.
OPENWEATHER_API_KEY=

# -- Carte 3D Mapbox (token public pk. -- https://account.mapbox.com) --------
# Injecte au build Vite (frontend/.env) ; fallback si absent : saisie manuelle
# dans les settings de l'app (localStorage).
VITE_MAPBOX_TOKEN=
